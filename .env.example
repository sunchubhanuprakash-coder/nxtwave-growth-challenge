# ==============================================================================
# NXTWAVE AI GROWTH ENGINE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to .env for local development: cp .env.example .env
# 2. Never commit .env with production credentials to source control.
# 3. In production, set these variables in your container orchestrator / cloud provider.
# ==============================================================================

# Application Environment Mode
# Options: "development" | "staging" | "production"
ENVIRONMENT=production
DEBUG=False
APP_NAME="NxtWave AI Student Growth Engine"
APP_VERSION="1.0.0"
API_V1_STR="/api/v1"
PORT=8000
HOST="0.0.0.0"

# Security & Authentication Keys
# Generate random 64-character secret keys in production: openssl rand -hex 32
SECRET_KEY="generate_a_secure_random_production_secret_key_minimum_32_chars"
ADMIN_API_KEY="generate_a_secure_admin_key_for_mutations_and_telemetry"

# Cross-Origin Resource Sharing (CORS) Whitelist
# JSON array of origins permitted to communicate with the API
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:80","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:8000"]

# Database Connection URL
# SQLite (Local Development / Single Container):
DATABASE_URL="sqlite:///./data/growth_engine.db"
# PostgreSQL (Production Scaled Database):
# DATABASE_URL="postgresql://growth_user:secure_password@postgres_host:5432/growth_engine_db"

# Campaign Guardrails & Sprint Targets
CAMPAIGN_TARGET_REGISTRATIONS=500
CAMPAIGN_BUDGET_INR=2000.0
CAMPAIGN_DURATION_DAYS=7
WORKSHOP_TITLE="Build Your First AI Project in 60 Minutes"

# AI Growth Copilot Provider
# Options:
#   - "deterministic_fallback": 100% reliable local mathematical analysis (Zero API key required)
#   - "openai": Uses OpenAI GPT models (requires OPENAI_API_KEY)
#   - "gemini": Uses Google Gemini models (requires GEMINI_API_KEY)
AI_PROVIDER="deterministic_fallback"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
AI_MODEL_NAME="gpt-4o-mini"
AI_TEMPERATURE=0.7

# Viral Referral Engine Parameters
REFERRAL_CODE_PREFIX="NXT-"
TIER_1_REFERRAL_THRESHOLD=1
TIER_2_REFERRAL_THRESHOLD=3

# Frontend Origin URL (Used to construct public Squad Pass share links)
FRONTEND_URL="http://localhost:5173"
